{
  "name": "site-security-auditor/wordpress-plugin",
  "description": "Read-only security posture audits for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "SiteSecurityAuditor\\": "site-security-auditor/includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SiteSecurityAuditor\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "test": [
      "@test:php",
      "@test:self-checks"
    ],
    "test:php": "phpunit -c phpunit.xml.dist",
    "test:self-checks": [
      "@php tests/unit/checks.php",
      "@php tests/unit/checks.php debug",
      "@php tests/unit/checks.php secure",
      "@php tests/unit/checks.php mods",
      "@php tests/unit/filesystem.php",
      "@php tests/unit/output.php",
      "@php tests/unit/schema.php",
      "@php tests/unit/advisory-cursor.php",
      "@php tests/unit/provider-validation.php",
      "@php tests/unit/package.php"
    ],
    "test:wp": "phpunit -c phpunit-wp.xml.dist",
    "lint": "phpcs"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    }
  }
}
